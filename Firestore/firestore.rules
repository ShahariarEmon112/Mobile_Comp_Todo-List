rules_version = '2';

// Security rules for the Firebase Todo App.
//
// Data layout:  users/{uid}/tasks/{taskId}
//
// - Only the signed-in owner (request.auth.uid == uid) can read or write
//   their own tasks. Everything else is denied.
// - Every write is validated: allowed fields only, correct types and sizes,
//   id/ownerId matching the path, and server-set timestamps.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function allowedTaskFields() {
      return ['id', 'ownerId', 'title', 'description', 'isCompleted', 'createdAt', 'updatedAt'];
    }

    // Limits match InputValidator.swift.
    function isValidTitle(title) {
      return title is string
        && title.size() > 0
        && title.size() <= 120
        && title.trim().size() > 0;
    }

    function isValidDescription(description) {
      return description is string && description.size() <= 1000;
    }

    function isValidNewTask(uid, taskId) {
      let task = request.resource.data;
      return task.keys().hasOnly(allowedTaskFields())
        && task.keys().hasAll(['id', 'ownerId', 'title', 'description', 'isCompleted', 'createdAt'])
        && task.id == taskId
        && task.ownerId == uid
        && isValidTitle(task.title)
        && isValidDescription(task.description)
        && task.isCompleted is bool
        && task.createdAt == request.time
        && (!('updatedAt' in task) || task.updatedAt == request.time);
    }

    function isValidTaskUpdate() {
      let task = request.resource.data;
      let changed = task.diff(resource.data).affectedKeys();
      return task.keys().hasOnly(allowedTaskFields())
        // Identity and creation date can never change.
        && !changed.hasAny(['id', 'ownerId', 'createdAt'])
        && changed.hasOnly(['title', 'description', 'isCompleted', 'updatedAt'])
        && isValidTitle(task.title)
        && isValidDescription(task.description)
        && task.isCompleted is bool
        && task.updatedAt == request.time;
    }

    // ---------- Rules ----------

    match /users/{uid} {
      // No profile document is stored; the parent path exists only for tasks.
      allow read, write: if false;

      match /tasks/{taskId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && isValidNewTask(uid, taskId);
        allow update: if isOwner(uid) && resource.data.ownerId == uid && isValidTaskUpdate();
        allow delete: if isOwner(uid);
      }
    }

    // Deny everything that is not matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
