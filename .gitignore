# ---- Firebase secrets / local config -------------------------------------
# Stray downloaded copies (e.g. "GoogleService-Info (1).plist") are ignored.
GoogleService-Info.plist
**/GoogleService-Info*.plist
# The app's Firebase client config IS committed so the project builds after cloning.
# It identifies the Firebase project; access is protected by Auth + firestore.rules.
!FirebaseTodoApp/Resources/GoogleService-Info.plist
# Service account keys must never be committed.
*-firebase-adminsdk-*.json
serviceAccount*.json
service-account*.json
*.p8
*.p12
*.mobileprovision
.env
.env.*

# ---- Xcode / XcodeGen ------------------------------------------------------
# The .xcodeproj is generated from project.yml by XcodeGen.
*.xcodeproj
*.xcworkspace
xcuserdata/
DerivedData/
build/
*.xcresult
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# ---- Swift Package Manager -------------------------------------------------
.build/
.swiftpm/
Packages/

# ---- Node / Firebase emulator (rules tests) --------------------------------
node_modules/
firebase-debug.log*
firestore-debug.log*
ui-debug.log*
.firebase/
*.log

# ---- OS / editors ----------------------------------------------------------
.DS_Store
.idea/
.vscode/
*.swp
